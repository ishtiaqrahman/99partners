{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ninetynine-acquisition-workbench",
  "main": "src/chat.ts",
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1042",
      "simple": { "limit": 8, "period": 60 },
    },
  ],
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/chat"],
    "not_found_handling": "single-page-application",
  },
}
